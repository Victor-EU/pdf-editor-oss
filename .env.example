# PDF Editor Environment Variables

# Backend Configuration
PDFTOOLS_LICENSE_KEY=<YOUR_PDFTOOLS_SDK_LICENSE_KEY>

# Optional: Change server ports if needed
# BACKEND_PORT=8080
# FRONTEND_PORT=3000

# Tesseract OCR Configuration (optional - auto-detected if not set)
# TESSERACT_CMD=/opt/homebrew/bin/tesseract       # macOS Homebrew (Apple Silicon)
# TESSERACT_CMD=/usr/local/bin/tesseract          # macOS Homebrew (Intel)
# TESSERACT_CMD=/usr/bin/tesseract                # Linux
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe  # Windows
# TESSERACT_LANGUAGE_DATA=/custom/path/to/tessdata  # Optional: Custom language data path

# File Cleanup Configuration
# AUTO_CLEANUP_ENABLED=True
# CLEANUP_INTERVAL_MINUTES=5
# FILE_RETENTION_MINUTES=5

# Optional: Database configuration (for future enhancement)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=pdfeditor
# DB_USER=admin
# DB_PASSWORD=password

# Optional: AWS S3 (for future file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
