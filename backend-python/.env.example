# PDF Editor Backend - Environment Configuration Example
# Copy this file to .env and update with your production values

# Application Info
APP_NAME="PDF Editor API"
APP_VERSION="2.0.0"
APP_DESCRIPTION="Open source PDF editing operations with FastAPI"

# Server Configuration
HOST="0.0.0.0"
PORT=8080
DEBUG=false
RELOAD=false

# CORS Configuration
# IMPORTANT: Update this for production with your actual domain(s)
# Comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"
# For production example:
# CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
CORS_ALLOW_CREDENTIALS=true

# File Storage Configuration
# UPLOAD_DIR="./uploads"
# OUTPUT_DIR="./output"
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# PDF Processing Configuration
MAX_MERGE_FILES=50
MAX_PDF_PAGES=5000
DEFAULT_DPI=150

# Logging Configuration
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE="pdf_editor.log"

# Security Configuration
ENABLE_RATE_LIMITING=true
RATE_LIMIT_PER_MINUTE=60

# Cleanup Configuration
AUTO_CLEANUP_ENABLED=true
CLEANUP_INTERVAL_MINUTES=5
FILE_RETENTION_MINUTES=5

# OCR Configuration (Optional)
# TESSERACT_CMD="/usr/bin/tesseract"
# TESSERACT_LANGUAGE_DATA="/usr/share/tesseract-ocr/4.00/tessdata"
